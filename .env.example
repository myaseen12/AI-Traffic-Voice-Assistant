# ==============================================================================
# AI TRAFFIC VOICE ASSISTANT - ROOT DOCKER & ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_NAME="AI Traffic Voice Assistant API"
APP_ENV=development                       # "development" | "staging" | "production"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440           # 24 hours

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL=sqlite:///./traffic_assistant.db
# DATABASE_URL=postgresql://traffic_user:traffic_secure_pass_2026@localhost:5432/traffic_assistant_db

# PostgreSQL Docker Container Settings (used by docker-compose)
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=traffic_secure_pass_2026
POSTGRES_DB=traffic_assistant_db

# Frontend Production API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & OTP Policies
OTP_MODE=development                      # "development" returns demo OTP for QA; "production" sends real SMS
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMS Gateway Integration (Production)
SMS_PROVIDER=mock                          # "mock" | "twilio" | "infobip" | "pta_gateway"
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=TRAFFICPOL

# AI & Voice Engine Configuration
LLM_PROVIDER=llama3                        # "llama3" | "groq" | "ollama" | "openai" | "gemini" | "mock"
LLAMA3_MODEL=llama-3-8b-instruct
LLAMA3_API_BASE=http://localhost:11434/v1
LLAMA3_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

WHISPER_PROVIDER=auto                      # "auto" | "local" | "groq" | "openai" | "mock"
WHISPER_MODEL=base

TTS_ENGINE=gtts
DEFAULT_LANGUAGE=en
