**/*.so
.Python
backend/venv
backend/env
.venv
venv
.pytest_cache
.coverage
htmlcov

# Environment & Secrets (NEVER INCLUDE IN DOCKER IMAGES)
.env
.env.*
!.env.example
*.pem
*.key

# Local Databases & Media Caches
*.db
*.sqlite
*.sqlite3
traffic_assistant.db
backend/traffic_assistant.db
backend/temp
backend/audio_cache
backend/uploads

