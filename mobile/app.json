{
  "expo": {
    "name": "AI Traffic Voice Assistant",
    "slug": "ai-traffic-voice-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aitraffic",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A192F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aitraffic.voiceassistant",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow AI Traffic Voice Assistant to access your camera to scan official traffic e-Challan QR codes.",
        "NSMicrophoneUsageDescription": "Allow AI Traffic Voice Assistant to access your microphone to ask spoken traffic inquiries in Urdu, Pashto, or English."
      }
    },
    "android": {
      "package": "com.aitraffic.voiceassistant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A192F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AI Traffic Voice Assistant to scan e-Challan QR codes."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow AI Traffic Voice Assistant to record voice inquiries for Whisper transcription."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
