# ==============================================================================
# AI TRAFFIC VOICE ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_NAME="AI Traffic Voice Assistant API"
APP_ENV=development                       # "development" | "staging" | "production"
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & JWT Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440           # 24 hours (in minutes)

# OTP & Authentication Policies
OTP_MODE=development                      # "development" returns code in API response for QA/local testing
                                           # "production" strictly dispatches via SMS and omits code from responses
OTP_EXPIRE_MINUTES=5                       # Validity window for one-time pins
OTP_COOLDOWN_SECONDS=60                    # Minimum waiting time between consecutive resend requests
OTP_MAX_ATTEMPTS=5                         # Maximum incorrect verification attempts before invalidation
OTP_MAX_RESENDS_PER_HOUR=5                 # Maximum OTP generation requests allowed per phone number per hour

# Real SMS Gateway Configuration (Only engaged in production mode)
SMS_PROVIDER=mock                          # "mock" | "twilio" | "infobip" | "pta_gateway"
SMS_API_KEY=                               # Provider API key or Twilio Account SID
SMS_API_SECRET=                            # Provider API secret or Twilio Auth Token
SMS_SENDER_ID=TRAFFICPOL                   # Official PTA alphanumeric sender mask

# Database Connection (PostgreSQL in production, SQLite fallback for dev)
DATABASE_URL=sqlite:///./traffic_assistant.db
# DATABASE_URL=postgresql://traffic_user:StrongPassword123@localhost:5432/traffic_assistant_db

# Artificial Intelligence (Llama 3 Grounded Engine & Whisper STT)
LLM_PROVIDER=llama3                        # "llama3" | "groq" | "ollama" | "openai" | "gemini" | "mock"
LLAMA3_MODEL=llama-3-8b-instruct
LLAMA3_API_BASE=http://localhost:11434/v1
LLAMA3_API_KEY=
LLAMA3_TEMPERATURE=0.1
LLAMA3_MAX_TOKENS=512

WHISPER_PROVIDER=auto                      # "auto" | "local" | "groq" | "openai" | "mock"
WHISPER_MODEL=base
WHISPER_API_BASE=
WHISPER_API_KEY=
MAX_AUDIO_SIZE_BYTES=26214400              # 25 MB
MIN_AUDIO_SIZE_BYTES=100

OPENAI_API_KEY=
GEMINI_API_KEY=
TTS_ENGINE=gtts
DEFAULT_LANGUAGE=en

# CORS Allowed Origins (Comma separated in reverse proxy, or array in config)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
